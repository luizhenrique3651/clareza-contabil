generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("tenant_status")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("company_status")
}

enum MembershipScope {
  TENANT
  COMPANY
  BRANCH

  @@map("membership_scope")
}

enum FinancialStatus {
  OPEN
  PARTIAL
  SETTLED
  OVERDUE
  CANCELLED

  @@map("financial_status")
}

enum CounterpartyKind {
  SUPPLIER
  CUSTOMER
  BOTH

  @@map("counterparty_kind")
}

enum FinancialDirection {
  PAYABLE
  RECEIVABLE
  BOTH

  @@map("financial_direction")
}

enum FinancialAccountType {
  CASH
  CHECKING
  SAVINGS
  PAYMENT
  OTHER

  @@map("financial_account_type")
}

enum BankImportFormat {
  CSV
  OFX

  @@map("bank_import_format")
}

enum ReconciliationParticipantKind {
  BANK_TRANSACTION
  PAYMENT
  RECEIPT

  @@map("reconciliation_participant_kind")
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED

  @@map("journal_entry_status")
}

enum GlossaryCategory {
  ACCOUNTING
  FINANCIAL
  FISCAL
  TAX
  LABOR
  PAYROLL
  CONTROLLERSHIP
  AUDIT
  MANAGEMENT
  INDICATORS

  @@map("glossary_category")
}

enum Priority {
  INFORMATIONAL
  ATTENTION
  IMPORTANT
  CRITICAL

  @@map("priority")
}

enum WorkStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  RESOLVED
  CANCELLED

  @@map("work_status")
}

enum RiskLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH

  @@map("risk_level")
}

enum RiskStatus {
  IDENTIFIED
  UNDER_ANALYSIS
  TREATMENT_PLANNED
  IN_TREATMENT
  MONITORING
  MITIGATED
  ACCEPTED
  CLOSED

  @@map("risk_status")
}

enum ActionPlanStatus {
  PLANNED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED

  @@map("action_plan_status")
}

model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String       @db.VarChar(160)
  slug      String       @unique(map: "tenants_slug_key") @db.VarChar(80)
  status    TenantStatus @default(ACTIVE)
  settings  Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(6)

  companies           Company[]
  branches            Branch[]
  users               User[]
  authIdentities      AuthIdentity[]
  memberships         Membership[]
  roles               Role[]
  permissions         Permission[]
  rolePermissions     RolePermission[]
  payables            Payable[]
  receivables         Receivable[]
  counterparties      Counterparty[]
  financialCategories FinancialCategory[]
  costCenters         CostCenter[]
  financialAccounts   FinancialAccount[]
  payments            Payment[]
  paymentReversals    PaymentReversal[]
  receipts            Receipt[]
  receiptReversals    ReceiptReversal[]
  bankImports         BankImport[]
  bankTransactions    BankTransaction[]
  reconciliationGroups BankReconciliationGroup[]
  reconciliationItems BankReconciliationItem[]
  reconciliationReversals BankReconciliationReversal[]
  journalEntries      JournalEntry[]
  journalLines        JournalEntryLine[]
  glossaryTerms       GlossaryTerm[]
  pendingItems        PendingItem[]
  risks               Risk[]
  actionPlans         ActionPlan[]
  auditLogs           AuditLog[]
  idempotencyRecords  IdempotencyRecord[]

  @@map("tenants")
}

model Company {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  legalName    String        @map("legal_name") @db.VarChar(180)
  tradeName    String?       @map("trade_name") @db.VarChar(180)
  taxId        String        @map("tax_id") @db.VarChar(24)
  countryCode  String        @default("BR") @map("country_code") @db.Char(2)
  currencyCode String        @default("BRL") @map("currency_code") @db.Char(3)
  timezone     String        @default("America/Sao_Paulo") @db.VarChar(80)
  status       CompanyStatus @default(ACTIVE)
  settings     Json          @default("{}")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "companies_tenant_id_fk")
  branches            Branch[]
  memberships         Membership[]
  payables            Payable[]
  receivables         Receivable[]
  counterparties      Counterparty[]
  financialCategories FinancialCategory[]
  costCenters         CostCenter[]
  financialAccounts   FinancialAccount[]
  payments            Payment[]
  paymentReversals    PaymentReversal[]
  receipts            Receipt[]
  receiptReversals    ReceiptReversal[]
  bankImports         BankImport[]
  bankTransactions    BankTransaction[]
  reconciliationGroups BankReconciliationGroup[]
  reconciliationItems BankReconciliationItem[]
  reconciliationReversals BankReconciliationReversal[]
  journalEntries      JournalEntry[]
  journalLines        JournalEntryLine[]
  pendingItems        PendingItem[]
  risks               Risk[]
  actionPlans         ActionPlan[]
  auditLogs           AuditLog[]

  @@unique([tenantId, id], map: "companies_tenant_id_id_key")
  @@unique([tenantId, taxId], map: "companies_tenant_tax_id_key")
  @@index([tenantId, status], map: "companies_tenant_status_idx")
  @@map("companies")
}

model Branch {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  code      String        @db.VarChar(40)
  name      String        @db.VarChar(160)
  taxId     String?       @map("tax_id") @db.VarChar(24)
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "branches_tenant_id_fk")
  company             Company             @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "branches_company_fk")
  memberships         Membership[]
  payables            Payable[]
  receivables         Receivable[]
  counterparties      Counterparty[]
  financialCategories FinancialCategory[]
  costCenters         CostCenter[]
  financialAccounts   FinancialAccount[]
  payments            Payment[]
  paymentReversals    PaymentReversal[]
  receipts            Receipt[]
  receiptReversals    ReceiptReversal[]
  bankImports         BankImport[]
  bankTransactions    BankTransaction[]
  reconciliationGroups BankReconciliationGroup[]
  reconciliationReversals BankReconciliationReversal[]
  journalEntries      JournalEntry[]
  pendingItems        PendingItem[]
  risks               Risk[]
  actionPlans         ActionPlan[]
  auditLogs           AuditLog[]

  @@unique([tenantId, id], map: "branches_tenant_id_id_key")
  @@unique([tenantId, companyId, id], map: "branches_tenant_company_id_id_key")
  @@unique([tenantId, companyId, code], map: "branches_tenant_company_code_key")
  @@index([tenantId, companyId, status], map: "branches_tenant_company_status_idx")
  @@map("branches")
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  email            String    @db.VarChar(254)
  displayName      String    @map("display_name") @db.VarChar(160)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  explanationLevel String    @default("ESSENTIAL") @map("explanation_level") @db.VarChar(20)
  locale           String    @default("pt-BR") @db.VarChar(16)
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant                     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "users_tenant_id_fk")
  authIdentities             AuthIdentity[]
  memberships                Membership[]
  createdPayables            Payable[]           @relation("PayableCreatedBy")
  updatedPayables            Payable[]           @relation("PayableUpdatedBy")
  createdReceivables         Receivable[]        @relation("ReceivableCreatedBy")
  updatedReceivables         Receivable[]        @relation("ReceivableUpdatedBy")
  createdCounterparties      Counterparty[]      @relation("CounterpartyCreatedBy")
  createdFinancialCategories FinancialCategory[] @relation("FinancialCategoryCreatedBy")
  createdCostCenters         CostCenter[]        @relation("CostCenterCreatedBy")
  createdFinancialAccounts   FinancialAccount[]  @relation("FinancialAccountCreatedBy")
  createdPayments            Payment[]           @relation("PaymentCreatedBy")
  createdPaymentReversals    PaymentReversal[]   @relation("PaymentReversalCreatedBy")
  createdReceipts            Receipt[]           @relation("ReceiptCreatedBy")
  createdReceiptReversals    ReceiptReversal[]   @relation("ReceiptReversalCreatedBy")
  createdBankImports         BankImport[]        @relation("BankImportCreatedBy")
  createdReconciliationGroups BankReconciliationGroup[] @relation("BankReconciliationCreatedBy")
  createdReconciliationReversals BankReconciliationReversal[] @relation("BankReconciliationReversalCreatedBy")
  createdJournalEntries      JournalEntry[]      @relation("JournalEntryCreatedBy")
  updatedJournalEntries      JournalEntry[]      @relation("JournalEntryUpdatedBy")
  assignedPendingItems       PendingItem[]       @relation("PendingResponsible")
  ownedRisks                 Risk[]              @relation("RiskOwner")
  ownedActionPlans           ActionPlan[]        @relation("ActionPlanOwner")
  auditEvents                AuditLog[]          @relation("AuditActor")
  idempotencyRecords         IdempotencyRecord[]

  @@unique([tenantId, id], map: "users_tenant_id_id_key")
  @@unique([tenantId, email], map: "users_tenant_email_key")
  @@index([tenantId, isActive], map: "users_tenant_active_idx")
  @@map("users")
}

model AuthIdentity {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  provider   String    @db.VarChar(40)
  subject    String    @db.VarChar(254)
  email      String    @db.VarChar(254)
  isActive   Boolean   @default(true) @map("is_active")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "auth_identities_tenant_fk")
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "auth_identities_user_fk")

  @@unique([provider, subject, tenantId], map: "auth_identities_provider_subject_tenant_key")
  @@unique([tenantId, userId, provider], map: "auth_identities_user_provider_key")
  @@index([provider, email, isActive], map: "auth_identities_email_active_idx")
  @@map("auth_identities")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "roles_tenant_id_fk")
  memberships     Membership[]
  rolePermissions RolePermission[]

  @@unique([tenantId, id], map: "roles_tenant_id_id_key")
  @@unique([tenantId, code], map: "roles_tenant_code_key")
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "permissions_tenant_id_fk")
  rolePermissions RolePermission[]

  @@unique([tenantId, id], map: "permissions_tenant_id_id_key")
  @@unique([tenantId, code], map: "permissions_tenant_code_key")
  @@map("permissions")
}

model RolePermission {
  tenantId     String   @map("tenant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "role_permissions_tenant_id_fk")
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_role_fk")
  permission Permission @relation(fields: [tenantId, permissionId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_permission_fk")

  @@id([tenantId, roleId, permissionId], map: "role_permissions_pkey")
  @@index([tenantId, permissionId], map: "role_permissions_permission_idx")
  @@map("role_permissions")
}

model Membership {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  roleId    String          @map("role_id") @db.Uuid
  scope     MembershipScope
  companyId String?         @map("company_id") @db.Uuid
  branchId  String?         @map("branch_id") @db.Uuid
  isActive  Boolean         @default(true) @map("is_active")
  startsAt  DateTime?       @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime?       @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "memberships_tenant_id_fk")
  user    User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "memberships_user_fk")
  role    Role     @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "memberships_role_fk")
  company Company? @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "memberships_company_fk")
  branch  Branch?  @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Cascade, onUpdate: NoAction, map: "memberships_branch_fk")

  @@unique([tenantId, id], map: "memberships_tenant_id_id_key")
  @@index([tenantId, userId, isActive], map: "memberships_user_active_idx")
  @@index([tenantId, companyId, branchId], map: "memberships_scope_idx")
  @@map("memberships")
}

model Payable {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  branchId          String?         @map("branch_id") @db.Uuid
  counterpartyId    String?         @map("counterparty_id") @db.Uuid
  categoryId        String?         @map("category_id") @db.Uuid
  costCenterId      String?         @map("cost_center_id") @db.Uuid
  counterpartyName  String          @map("counterparty_name") @db.VarChar(180)
  description       String          @db.VarChar(500)
  documentNumber    String?         @map("document_number") @db.VarChar(80)
  issueDate         DateTime?       @map("issue_date") @db.Date
  dueDate           DateTime        @map("due_date") @db.Date
  amount            Decimal         @db.Decimal(19, 4)
  outstandingAmount Decimal         @map("outstanding_amount") @db.Decimal(19, 4)
  currencyCode      String          @default("BRL") @map("currency_code") @db.Char(3)
  status            FinancialStatus @default(OPEN)
  paidAt            DateTime?       @map("paid_at") @db.Timestamptz(6)
  createdById       String          @map("created_by_id") @db.Uuid
  updatedById       String?         @map("updated_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payables_tenant_id_fk")
  company      Company            @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "payables_company_fk")
  branch       Branch?            @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "payables_branch_fk")
  counterparty Counterparty?      @relation(fields: [tenantId, companyId, counterpartyId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "payables_counterparty_fk")
  category     FinancialCategory? @relation(fields: [tenantId, companyId, categoryId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "payables_category_fk")
  costCenter   CostCenter?        @relation(fields: [tenantId, companyId, costCenterId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "payables_cost_center_fk")
  createdBy    User               @relation("PayableCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "payables_created_by_fk")
  updatedBy    User?              @relation("PayableUpdatedBy", fields: [tenantId, updatedById], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "payables_updated_by_fk")
  payments     Payment[]

  @@unique([tenantId, companyId, id], map: "payables_tenant_company_id_key")
  @@index([tenantId, companyId, status, dueDate], map: "payables_status_due_idx")
  @@index([tenantId, companyId, counterpartyName], map: "payables_counterparty_idx")
  @@index([tenantId, companyId, counterpartyId, categoryId, costCenterId], map: "payables_catalog_idx")
  @@map("payables")
}

model Receivable {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  branchId          String?         @map("branch_id") @db.Uuid
  counterpartyId    String?         @map("counterparty_id") @db.Uuid
  categoryId        String?         @map("category_id") @db.Uuid
  costCenterId      String?         @map("cost_center_id") @db.Uuid
  counterpartyName  String          @map("counterparty_name") @db.VarChar(180)
  description       String          @db.VarChar(500)
  documentNumber    String?         @map("document_number") @db.VarChar(80)
  issueDate         DateTime?       @map("issue_date") @db.Date
  dueDate           DateTime        @map("due_date") @db.Date
  amount            Decimal         @db.Decimal(19, 4)
  outstandingAmount Decimal         @map("outstanding_amount") @db.Decimal(19, 4)
  currencyCode      String          @default("BRL") @map("currency_code") @db.Char(3)
  status            FinancialStatus @default(OPEN)
  receivedAt        DateTime?       @map("received_at") @db.Timestamptz(6)
  createdById       String          @map("created_by_id") @db.Uuid
  updatedById       String?         @map("updated_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "receivables_tenant_id_fk")
  company      Company            @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "receivables_company_fk")
  branch       Branch?            @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "receivables_branch_fk")
  counterparty Counterparty?      @relation(fields: [tenantId, companyId, counterpartyId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "receivables_counterparty_fk")
  category     FinancialCategory? @relation(fields: [tenantId, companyId, categoryId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "receivables_category_fk")
  costCenter   CostCenter?        @relation(fields: [tenantId, companyId, costCenterId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "receivables_cost_center_fk")
  createdBy    User               @relation("ReceivableCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "receivables_created_by_fk")
  updatedBy    User?              @relation("ReceivableUpdatedBy", fields: [tenantId, updatedById], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "receivables_updated_by_fk")
  receipts     Receipt[]

  @@unique([tenantId, companyId, id], map: "receivables_tenant_company_id_key")
  @@index([tenantId, companyId, status, dueDate], map: "receivables_status_due_idx")
  @@index([tenantId, companyId, counterpartyName], map: "receivables_counterparty_idx")
  @@index([tenantId, companyId, counterpartyId, categoryId, costCenterId], map: "receivables_catalog_idx")
  @@map("receivables")
}

model Counterparty {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  branchId    String?          @map("branch_id") @db.Uuid
  code        String           @db.VarChar(40)
  name        String           @db.VarChar(180)
  taxId       String?          @map("tax_id") @db.VarChar(24)
  kind        CounterpartyKind @default(BOTH)
  isActive    Boolean          @default(true) @map("is_active")
  createdById String           @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)


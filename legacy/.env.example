# Local development only. Copy to .env and replace every secret outside local use.
POSTGRES_DB=clarity_mvp
POSTGRES_USER=clarity_owner
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=5432

# Migrations/seed require the table-owner connection. Never expose it to requests.
DIRECT_DATABASE_URL=postgresql://clarity_owner:replace_with_local_password@127.0.0.1:5432/clarity_mvp?schema=public

# Runtime starts from the local owner login but immediately assumes clarity_app.
# Production should use a dedicated non-owner LOGIN role granted to clarity_app.
DATABASE_URL=postgresql://clarity_owner:replace_with_local_password@127.0.0.1:5432/clarity_mvp?schema=public&options=-c%20role%3Dclarity_app

# Generate at least 32 random bytes. Never commit the resulting value.
SESSION_SECRET=replace_with_at_least_32_random_bytes
SESSION_COOKIE_NAME=clarity_session
SESSION_TTL_SECONDS=28800
NODE_ENV=development
